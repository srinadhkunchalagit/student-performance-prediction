<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Performance Predictor</title>
    <meta name="description" content="Predict student academic performance based on study hours, attendance, previous marks, assignments, and internal scores.">
    <meta property="og:title" content="Student Performance Predictor">
    <meta property="og:description" content="Predict student academic performance based on study hours, attendance, previous marks, assignments, and internal scores.">

    <link rel="stylesheet" href="/static/style.css">
    <!-- jsPDF and AutoTable for Client-Side Report PDF Generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
</head>

<body>

    <div class="container">

        <header class="app-header">
            <div class="header-badge">AI / ML Academic Analytics</div>
            <h1>Student Performance Predictor</h1>
            <p class="subtitle">
                Comprehensive academic evaluation, result prediction, and automated parent reporting
            </p>
        </header>

        <form id="predictionForm" class="prediction-form" autocomplete="on">

            <!-- Section 1: Student & Parent Identification -->
            <div class="form-section">
                <h3 class="section-title">
                    <span class="step-num">1</span> Student & Parent Details
                </h3>

                <div class="grid-row">
                    <div class="input-group">
                        <label for="student_name">Student Name <span class="req">*</span></label>
                        <input
                            type="text"
                            id="student_name"
                            name="student_name"
                            placeholder="e.g. Rahul Sharma"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label for="branch">Branch / Specialization <span class="req">*</span></label>
                        <select id="branch" name="branch" required>
                            <option value="">Select Branch</option>
                            <option value="Computer Science & Engineering">Computer Science & Engineering</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="AI & Data Science">AI & Data Science</option>
                            <option value="Electronics & Communication">Electronics & Communication</option>
                            <option value="Electrical & Electronics">Electrical & Electronics</option>
                            <option value="Mechanical Engineering">Mechanical Engineering</option>
                            <option value="Civil Engineering">Civil Engineering</option>
                            <option value="Other">Other / General</option>
                        </select>
                    </div>
                </div>

                <div class="grid-row three-cols">
                    <div class="input-group">
                        <label for="student_mobile">Student Mobile Number</label>
                        <input
                            type="tel"
                            id="student_mobile"
                            name="student_mobile"
                            placeholder="e.g. +91 9876543210"
                        >
                    </div>

                    <div class="input-group">
                        <label for="parent_name">Parent / Guardian Name <span class="req">*</span></label>
                        <input
                            type="text"
                            id="parent_name"
                            name="parent_name"
                            placeholder="e.g. Suresh Sharma"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label for="parent_mobile">Parent Mobile Number <span class="req">*</span></label>
                        <input
                            type="tel"
                            id="parent_mobile"
                            name="parent_mobile"
                            placeholder="e.g. +91 9876500001"
                            required
                        >
                    </div>
                </div>
            </div>

            <!-- Section 2: Academic Factors -->
            <div class="form-section">
                <h3 class="section-title">
                    <span class="step-num">2</span> Academic Performance Metrics
                </h3>

                <div class="grid-row">
                    <div class="input-group">
                        <label for="study_hours">
                            Study Hours <span class="metric-scale">(per day, 0 - 24 hrs)</span> <span class="req">*</span>
                        </label>
                        <input
                            type="number"
                            id="study_hours"
                            name="study_hours"
                            min="0"
                            max="24"
                            step="0.1"
                            placeholder="e.g. 5.5"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label for="attendance">
                            Attendance <span class="metric-scale">(percentage, 0 - 100%)</span> <span class="req">*</span>
                        </label>
                        <input
                            type="number"
                            id="attendance"
                            name="attendance"
                            min="0"
                            max="100"
                            step="0.1"
                            placeholder="e.g. 85.0"
                            required
                        >
                    </div>
                </div>

                <div class="grid-row three-cols">
                    <div class="input-group">
                        <label for="previous_marks">
                            Previous Marks <span class="metric-scale">(out of 70)</span> <span class="req">*</span>
                        </label>
                        <input
                            type="number"
                            id="previous_marks"
                            name="previous_marks"
                            min="0"
                            max="70"
                            step="0.5"
                            placeholder="e.g. 52.0"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label for="assignment_score">
                            Assignment Score <span class="metric-scale">(out of 5)</span> <span class="req">*</span>
                        </label>
                        <input
                            type="number"
                            id="assignment_score"
                            name="assignment_score"
                            min="0"
                            max="5"
                            step="0.1"
                            placeholder="e.g. 4.2"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label for="internal_marks">
                            Internal Marks <span class="metric-scale">(out of 30)</span> <span class="req">*</span>
                        </label>
                        <input
                            type="number"
                            id="internal_marks"
                            name="internal_marks"
                            min="0"
                            max="30"
                            step="0.5"
                            placeholder="e.g. 24.5"
                            required
                        >
                    </div>
                </div>
            </div>

            <button type="submit" id="submitBtn" class="primary-btn">
                <span>🔮 Predict Result & Generate Report</span>
            </button>

        </form>

        <!-- Prediction Result & Action Card -->
        <div id="resultCard" class="result-card hidden">
            <div class="result-header">
                <div class="result-badge-wrap">
                    <span class="result-label">Predicted Academic Standing:</span>
                    <span id="predictionBadge" class="prediction-badge">PASS</span>
                </div>
                <div class="confidence-wrap">
                    <span class="confidence-title">Performance Index / Confidence:</span>
                    <span id="confidenceValue" class="confidence-val">88%</span>
                </div>
            </div>

            <div class="result-details">
                <div class="report-meta-grid">
                    <div><strong>Student:</strong> <span id="resStudentName">-</span></div>
                    <div><strong>Branch:</strong> <span id="resBranch">-</span></div>
                    <div><strong>Parent:</strong> <span id="resParentName">-</span></div>
                    <div><strong>Parent Phone:</strong> <span id="resParentMobile">-</span></div>
                </div>

                <div class="academic-summary-bar">
                    <div class="metric-chip">
                        <span class="chip-label">Study Hrs/Day</span>
                        <span id="resStudyHours" class="chip-val">-</span>
                    </div>
                    <div class="metric-chip">
                        <span class="chip-label">Attendance</span>
                        <span id="resAttendance" class="chip-val">-</span>
                    </div>
                    <div class="metric-chip">
                        <span class="chip-label">Previous Marks</span>
                        <span id="resPrevMarks" class="chip-val">- / 70</span>
                    </div>
                    <div class="metric-chip">
                        <span class="chip-label">Assignment</span>
                        <span id="resAssignment" class="chip-val">- / 5</span>
                    </div>
                    <div class="metric-chip">
                        <span class="chip-label">Internals</span>
                        <span id="resInternal" class="chip-val">- / 30</span>
                    </div>
                </div>

                <div class="recommendation-box">
                    <strong>💡 Faculty Advisory & Recommendations:</strong>
                    <p id="resRecommendation">-</p>
                </div>
            </div>

            <!-- Action buttons for PDF & Parent Delivery -->
            <div class="result-actions">
                <button type="button" id="downloadPdfBtn" class="action-btn pdf-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download PDF Report
                </button>

                <button type="button" id="sendSmsBtn" class="action-btn sms-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    <span>⚡ Send Direct SMS to Parent</span>
                </button>

                <button type="button" id="sendWhatsAppBtn" class="action-btn whatsapp-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.78 14.15c-.24.67-1.39 1.28-1.92 1.36-.5.08-1.14.12-3.69-.93-3.26-1.35-5.36-4.66-5.52-4.88-.16-.22-1.32-1.76-1.32-3.36 0-1.6 1.05-2.39 1.42-2.73.37-.34.8-.43 1.07-.43.27 0 .54.01.78.02.25.02.58-.09.91.7.34.8 1.16 2.82 1.26 3.03.1.21.17.46.03.73-.14.28-.21.45-.42.7-.21.25-.44.55-.63.74-.21.21-.43.44-.19.85.24.42 1.07 1.76 2.3 2.86 1.58 1.41 2.91 1.85 3.33 2.05.42.21.66.18.91-.1.25-.29 1.07-1.25 1.36-1.68.29-.43.58-.36.98-.21.4.14 2.54 1.2 2.98 1.42.44.22.73.33.84.52.1.18.1.98-.14 1.65z"/></svg>
                    Share via WhatsApp
                </button>
            </div>
            <div id="dispatchStatus" class="dispatch-status"></div>
        </div>

        <!-- Direct SMS Confirmation Modal (No external app opened) -->
        <div id="smsModal" class="sms-modal hidden">
            <div class="sms-modal-backdrop" onclick="closeSmsModal()"></div>
            <div class="sms-modal-content">
                <div class="sms-modal-header">
                    <div class="sms-status-icon">✓</div>
                    <div>
                        <h3>Direct SMS Sent Successfully</h3>
                        <p class="sms-modal-sub">Delivered directly to parent mobile without opening any app</p>
                    </div>
                    <button type="button" class="close-modal-btn" onclick="closeSmsModal()">✕</button>
                </div>
                <div class="sms-modal-body">
                    <div class="sms-info-row">
                        <span class="sms-info-label">Parent Recipient:</span>
                        <span id="smsModalRecipient" class="sms-info-val">-</span>
                    </div>
                    <div class="sms-info-row">
                        <span class="sms-info-label">Delivery Status:</span>
                        <span class="sms-badge-delivered">DELIVERED DIRECTLY</span>
                    </div>
                    <div class="sms-info-row">
                        <span class="sms-info-label">Dispatch Ref / ID:</span>
                        <span id="smsModalDispatchId" class="sms-info-val sms-code">-</span>
                    </div>
                    <div class="sms-info-row">
                        <span class="sms-info-label">Delivery Timestamp:</span>
                        <span id="smsModalTimestamp" class="sms-info-val">-</span>
                    </div>
                    <div class="sms-preview-wrap">
                        <span class="sms-preview-title">Delivered SMS Content (with PDF Report Link):</span>
                        <div id="smsModalMessage" class="sms-preview-box">-</div>
                    </div>
                </div>
                <div class="sms-modal-footer">
                    <button type="button" class="modal-close-action-btn" onclick="closeSmsModal()">Done</button>
                </div>
            </div>
        </div>

        <!-- History navigation / toggle -->
        <div class="history-bar">
            <a href="/history" class="history-button">
                📋 View Prediction History (<%= history ? history.length : 'All' %>)
            </a>
            <% if (history) { %>
            <a href="/" class="back-link">← Back to New Prediction</a>
            <% } %>
        </div>

        <% if (history && history.length > 0) { %>

        <section class="history-section">
            <div class="history-title-wrap">
                <h2>Prediction History</h2>
                <span class="count-badge"><%= history.length %> records</span>
            </div>

            <div class="table-responsive">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Student & Branch</th>
                            <th>Student Phone</th>
                            <th>Parent Details</th>
                            <th>Study Hrs/Day</th>
                            <th>Attendance</th>
                            <th>Prev (/70)</th>
                            <th>Assign (/5)</th>
                            <th>Internal (/30)</th>
                            <th>Predicted Result</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% history.forEach(function(row) { %>
                        <tr>
                            <td><strong>#<%= row.id %></strong></td>
                            <td>
                                <div class="student-cell">
                                    <span class="cell-name"><%= row.student_name %></span>
                                    <span class="cell-sub"><%= row.branch %></span>
                                </div>
                            </td>
                            <td><%= row.student_mobile %></td>
                            <td>
                                <div class="parent-cell">
                                    <span class="cell-name"><%= row.parent_name %></span>
                                    <span class="cell-sub"><%= row.parent_mobile %></span>
                                </div>
                            </td>
                            <td><%= row.study_hours %> hrs</td>
                            <td><%= row.attendance %>%</td>
                            <td><%= row.previous_marks %></td>
                            <td><%= row.assignment_score %></td>
                            <td><%= row.internal_marks %></td>
                            <td>
                                <span class="table-badge <%= row.prediction === 'PASS' ? 'badge-pass' : 'badge-fail' %>">
                                    <%= row.prediction %>
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button
                                        type="button"
                                        class="table-pdf-btn"
                                        onclick="generateReportPdfFromData(<%= JSON.stringify(row) %>)"
                                        title="Download PDF"
                                    >
                                        📥 PDF
                                    </button>
                                    <button
                                        type="button"
                                        class="table-sms-btn"
                                        onclick="sendParentSmsDirectlyFromData(<%= JSON.stringify(row) %>)"
                                        title="Send Direct SMS to Parent (No App)"
                                    >
                                        ⚡ SMS
                                    </button>
                                    <button
                                        type="button"
                                        class="table-wa-btn"
                                        onclick="sendParentWhatsAppFromData(<%= JSON.stringify(row) %>)"
                                        title="WhatsApp Parent"
                                    >
                                        💬 WhatsApp
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <% } else if (history) { %>
        <p class="empty-history">No student prediction records found yet. Run your first prediction above!</p>
        <% } %>

        <footer class="app-footer">
            <p>Student Performance Predictor • Powered by Logistic Regression & Academic Analytics</p>
        </footer>

    </div>

    <script src="/static/script.js"></script>

</body>

</html>
